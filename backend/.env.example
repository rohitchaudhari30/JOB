# Application Environment
APP_ENV=development
APP_NAME=Job Automation Platform
APP_PORT=8000
DEBUG=True
# Only create the demo.engineer@example.com account in local development.
SEED_DEMO_USER=False
# Emails (comma-separated) allowed to delete shared jobs. Leave empty for nobody.
ADMIN_EMAILS=

# Security Secrets (JWT & AES-256-GCM Session Storage)
# REQUIRED outside development. Generate your own, never reuse these examples:
#   SECRET_KEY:      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   ENCRYPTION_KEY:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# Database Connection
DATABASE_URL=sqlite+aiosqlite:///./app.db

# AI Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here

# Browser Automation Settings
BROWSER_HEADLESS=False
BROWSER_TIMEOUT_MS=30000
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
