# Used by docker-compose. Copy to `.env` and fill in real values.
APP_ENV=development
DEBUG=false
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Hide browser automation from websites. Check each site's terms first. Default: off.
BROWSER_STEALTH_ENABLED=false
